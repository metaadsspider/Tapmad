# ─────────────────────────────────────────────────────────────────────
# Put these values in Vercel: your project → Settings → Environment
# Variables. For local testing with `vercel dev`, copy this file to .env.
# ─────────────────────────────────────────────────────────────────────

# The ONLY place the real stream URL lives — set YOUR real m3u8 here:
UPSTREAM_MASTER=https://example.com/live/stream/index.m3u8

# Long random string (openssl rand -hex 32). MUST be the same on every
# deployment/environment, otherwise tokens stop validating:
SECRET=replace-with-long-random-string

# Extra origins allowed to open sessions (your own deployment origin is
# always allowed automatically). Comma separated:
ALLOWED_ORIGINS=https://crickontime1.vercel.app

# How long a stream session stays valid (hours). Shorter = safer:
SESSION_HOURS=2

# Bind tokens to the viewer IP (set false if viewers switch networks mid-stream):
BIND_IP=true

# Require the X-Player header on /live/* (set false to support old iPhone native HLS):
REQUIRE_HEADER=true

# User-Agent sent to the upstream CDN (some CDNs require a browser-like UA):
UPSTREAM_UA=Mozilla/5.0 (HLS relay)
