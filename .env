# Copy to .env next to server.js and edit. server.js reads .env automatically.

PORT=3000

# The ONLY place the real stream URL lives — never reaches the browser:
UPSTREAM_MASTER=https://55b0cd15-d8f2-4861-b60f-b4f5dc6be616.lovableproject.com/api/public/hls?url=https%3A%2F%2Famssandbrix.sandbrix.live%2Fsandbrix%2Fstreams%2Fmk139q1Mi9bHznBA775016895861.m3u8

# Long random string (openssl rand -hex 32). Keeps sessions valid across restarts:
SECRET=replace-with-long-random-string

# Origin(s) of the page allowed to open sessions, comma separated:
ALLOWED_ORIGINS=http://localhost:3000

# Bind tokens to the client IP (set false if viewers switch networks mid-stream):
BIND_IP=true

# Require the X-Player header on /live/* (set false to support iPhone native HLS):
REQUIRE_HEADER=true

# Set true when running behind nginx/Cloudflare (trusts X-Forwarded-For):
TRUST_PROXY=false

# User-Agent sent to the upstream CDN (some CDNs require a browser-like UA):
UPSTREAM_UA=Mozilla/5.0 (HLS relay)
